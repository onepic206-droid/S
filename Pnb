-- Added presend callback, unlike other callbacks this is direct call.

local CONFIG = {
    FARM_WORLD = "WORLDNAME",
    FARM_ID    = "ID",

    TARGET_BLOCK = 5,
    MAX_BLOCKS   = 40,
    MIN_HITS     = 3,

    RECONNECT_DELAY = 5000,
    WARP_DELAY      = 5000,
    COLLECT_DELAY   = 120,
    PATH_DELAY      = 300,
    LOOP_DELAY      = 1000
}

local client = getClient()
local working = false

local function worldFarm()
    return CONFIG.FARM_WORLD .. ":" .. CONFIG.FARM_ID
end

local function waitOnline()
    while client.status ~= GameClientStatus.online do
        if client.status == GameClientStatus.kicked
        or client.status == GameClientStatus.timeout
        or not client:connected() then
            client:connect()
        end

        sleep(CONFIG.RECONNECT_DELAY)
    end
end

local function waitWorld(worldName)
    local target = string.upper(worldName)

    while true do
        local nav = client:navigation()

        if nav and string.find(string.upper(tostring(nav)), target, 1, true) then
            return
        end

        sleep(1000)
    end
end

local function warpFarm()
    client:warp(worldFarm())
    sleep(CONFIG.WARP_DELAY)
    waitWorld(CONFIG.FARM_WORLD)
end

local function collectFloating()
    local w = client:world()
    if not w then return end

    for _, obj in pairs(w.collectables) do
        if obj and obj.point then
            local p = obj:point()

            client:findPath(Vector2i.new(p.x, p.y))
            sleep(CONFIG.PATH_DELAY)

            pcall(function()
                client:collect(obj.id)
            end)

            sleep(CONFIG.COLLECT_DELAY)
        end
    end
end

local function reconnectLoop()
    while true do
        if client.status == GameClientStatus.kicked
        or client.status == GameClientStatus.timeout
        or not client:connected() then

            working = false

            waitOnline()
            warpFarm()
        end

        sleep(2000)
    end
end

function breakBlocks(targetBlock, maxBlocks, minHits)
    client:on("presend", function(message)
        if working then return end
        working = true

        local amount = client:inventory():count(targetBlock, InventoryItemType.block)

        if amount <= 0 then
            working = false
            return
        end

        local clientPoint = client:point()

        local tilePoints = {
            Vector2i.new(clientPoint.x - 2, clientPoint.y - 2),
            Vector2i.new(clientPoint.x - 1, clientPoint.y - 2),
            Vector2i.new(clientPoint.x,     clientPoint.y - 2),
            Vector2i.new(clientPoint.x + 1, clientPoint.y - 2),
            Vector2i.new(clientPoint.x + 2, clientPoint.y - 2)
        }

        local blocks = math.min(amount, maxBlocks)

        for i = 1, blocks do
            if client.status ~= GameClientStatus.online then
                working = false
                return
            end

            local index = ((i - 1) % #tilePoints) + 1
            local tilePoint = tilePoints[index]

            client:place(tilePoint, targetBlock, InventoryItemType.block)

            for j = 1, minHits do
                client:send("HB", {
                    x = tilePoint.x,
                    y = tilePoint.y
                })
            end
        end

        working = false
    end)
end

runThread(function()
    while true do
        waitOnline()

        if client:navigation() == nil then
            warpFarm()
        end

        local amount = client:inventory():count(
            CONFIG.TARGET_BLOCK,
            InventoryItemType.block
        )

        if amount <= 0 then
            warpFarm()
            collectFloating()
        end

        sleep(CONFIG.LOOP_DELAY)
    end
end)

runThread(reconnectLoop)

breakBlocks(
    CONFIG.TARGET_BLOCK,
    CONFIG.MAX_BLOCKS,
    CONFIG.MIN_HITS
)
