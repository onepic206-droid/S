local CONFIG = {
    FARM_WORLD = "DEELS",
    FARM_ID    = "AI",

    TARGET_BLOCK = 5,
    MAX_BLOCKS   = 40,
    MIN_HITS     = 3,

    RECONNECT_DELAY = 5000,
    WARP_DELAY      = 5000,
    PATH_DELAY      = 300,
    COLLECT_DELAY   = 120,
    LOOP_DELAY      = 1000
}

local client = getClient()

local function isOnline()
    return client.status == GameClientStatus.online and client:connected()
end

local function inWorld()
    local nav = client:navigation()
    if not nav then return false end
    return string.find(string.upper(tostring(nav)), string.upper(CONFIG.FARM_WORLD), 1, true) ~= nil
end

local function warpNormal()
    while not isOnline() do
        client:connect()
        sleep(CONFIG.RECONNECT_DELAY)
    end

    while not inWorld() do
        client:warp(CONFIG.FARM_WORLD)
        sleep(CONFIG.WARP_DELAY)
    end
end

local function warpWithId()
    client:warp(CONFIG.FARM_WORLD .. ":" .. CONFIG.FARM_ID)
    sleep(CONFIG.WARP_DELAY)
end

local function collectFloating()
    local world = client:world()
    if not world then return end

    for _, obj in pairs(world.collectables) do
        local p = obj:point()
        if p then
            client:findPath(Vector2i.new(p.x, p.y))
            sleep(CONFIG.PATH_DELAY)
            client:collect(obj.id)
            sleep(CONFIG.COLLECT_DELAY)
        end
    end
end

local function pnb()
    local amount = client:inventory():count(CONFIG.TARGET_BLOCK, InventoryItemType.block)
    if amount <= 0 then return end

    local cp = client:point()

    local points = {
        Vector2i.new(cp.x - 2, cp.y - 2),
        Vector2i.new(cp.x - 1, cp.y - 2),
        Vector2i.new(cp.x,     cp.y - 2),
        Vector2i.new(cp.x + 1, cp.y - 2),
        Vector2i.new(cp.x + 2, cp.y - 2)
    }

    local total = math.min(amount, CONFIG.MAX_BLOCKS)

    for i = 1, total do
        if not isOnline() then return end

        local point = points[((i - 1) % #points) + 1]

        client:place(point, CONFIG.TARGET_BLOCK, InventoryItemType.block)

        for h = 1, CONFIG.MIN_HITS do
            client:send("HB", {
                x = point.x,
                y = point.y
            })
        end
    end
end

runThread(function()
    warpNormal()

    while true do
        if not isOnline() then
            warpNormal()
        end

        local amount = client:inventory():count(CONFIG.TARGET_BLOCK, InventoryItemType.block)

        if amount <= 0 then
            warpWithId()
            collectFloating()
            warpNormal()
        else
            if not inWorld() then
                warpNormal()
            end

            pnb()
        end

        sleep(CONFIG.LOOP_DELAY)
    end
end)
