local CONFIG = {
    FARM_WORLD = "NOLES:AB",

    ITEM_ID = 5,

    START_X = 2,
    START_Y = 9,
    BOT_Y_STEP = 4,

    DROP_X = 3,
    DROP_Y = 3,

    KEEP_SEED = 20,

    HIT_COUNT = 3,
    PLACE_COUNT = 3,

    HIT_DELAY = 180,
    PLACE_DELAY = 200,

    RAND_MIN = 50,
    RAND_MAX = 120,

    START_WAIT = 3000,
    PATH_TIMEOUT = 8000,

    BOT_START_MIN = 2000,
    BOT_START_MAX = 7000,

    BOT_THREAD_DELAY_MIN = 1500,
    BOT_THREAD_DELAY_MAX = 3500
}

local running = {}

local function rsleep()
    sleep(math.random(CONFIG.RAND_MIN, CONFIG.RAND_MAX))
end

local function nav(bot)
    local n = bot:navigation()
    if not n then return "#MENU" end
    return tostring(n):upper()
end

local function worldOnly(world)
    local s = tostring(world):upper()
    local p = string.find(s, ":")
    if p then return string.sub(s, 1, p - 1) end
    return s
end

local function inFarm(bot)
    local target = worldOnly(CONFIG.FARM_WORLD)
    return string.find(nav(bot), target, 1, true) ~= nil
end

local function ensureFarm(bot)
    while not inFarm(bot) do
        bot:warp(CONFIG.FARM_WORLD)
        sleep(4000)
    end
end

local function pathTo(bot, x, y)
    ensureFarm(bot)

    local pos = Vector2i.new(x, y)
    local p = bot:point()

    if p and p.x == x and p.y == y then return true end

    local ok = bot:findPath(pos)
    if ok == false then return false end

    local t = 0
    while bot:pathfinding() and t < CONFIG.PATH_TIMEOUT do
        sleep(25)
        t = t + 25
    end

    if t >= CONFIG.PATH_TIMEOUT then
        pcall(function() bot:clearPath() end)
        return false
    end

    return true
end

local function collectNearby(bot)
    local world = bot:world()
    local p = bot:point()
    if not world or not p then return end

    for _, obj in pairs(world.collectables) do
        local op = obj:point()
        local dist = math.abs(p.x - op.x) + math.abs(p.y - op.y)

        if dist <= 6 then
            pcall(function()
                bot:collect(obj.id)
            end)
            sleep(20)
        end
    end
end

local function getRow(bot)
    local bots = {}

    for _, b in pairs(getClients()) do
        if b and b.id then
            table.insert(bots, b)
        end
    end

    table.sort(bots, function(a, b)
        return tostring(a.id) < tostring(b.id)
    end)

    local index = 1

    for i, b in ipairs(bots) do
        if b.id == bot.id then
            index = i
            break
        end
    end

    return CONFIG.START_Y + ((index - 1) * CONFIG.BOT_Y_STEP)
end

local function canPlant(world, x, y)
    local tile = world:tile(Vector2i.new(x, y))
    local below = world:tile(Vector2i.new(x, y + 1))

    return tile and below and tile.foreground == 0 and below.foreground ~= 0
end

local function hasEmptyTile(bot, rowY)
    local world = bot:world()
    if not world then return false end

    for x = 1, world.size.x - 2 do
        if canPlant(world, x, rowY) then
            return true
        end
    end

    return false
end

local function plant(bot, rowY)
    local world = bot:world()
    if not world then return end

    local planted = 0

    for x = 1, world.size.x - 2 do
        local inv = bot:inventory()
        local seed = inv and inv:count(CONFIG.ITEM_ID, InventoryItemType.seed) or 0

        if seed <= 0 then return end
        if planted >= CONFIG.KEEP_SEED then return end

        world = bot:world()

        if world and canPlant(world, x, rowY) then
            pathTo(bot, x, rowY)

            pcall(function()
                bot:place(Vector2i.new(x, rowY), CONFIG.ITEM_ID, InventoryItemType.seed)
            end)

            planted = planted + 1

            sleep(CONFIG.PLACE_DELAY)
            rsleep()
        end
    end
end

local function harvest(bot, rowY)
    local world = bot:world()
    if not world then return end

    for x = 1, world.size.x - 2 do
        local pos = Vector2i.new(x, rowY)

        world = bot:world()
        local tile = world and world:tile(pos)

        if tile and tile.foreground ~= 0 then
            local tree = tile:tree()

            if tree and tree:ready() then
                pathTo(bot, x, rowY)

                for i = 1, 10 do
                    world = bot:world()
                    tile = world and world:tile(pos)

                    if not tile or tile.foreground == 0 then break end

                    pcall(function()
                        bot:hit(pos)
                    end)

                    sleep(CONFIG.HIT_DELAY)
                    rsleep()
                end

                collectNearby(bot)
            end
        end
    end
end

local function pnb(bot, rowY)
    local inv = bot:inventory()
    local block = inv and inv:count(CONFIG.ITEM_ID, InventoryItemType.block) or 0
    if block <= 0 then return end

    pathTo(bot, CONFIG.START_X, rowY)
    sleep(CONFIG.START_WAIT)

    while true do
        inv = bot:inventory()
        block = inv and inv:count(CONFIG.ITEM_ID, InventoryItemType.block) or 0
        if block <= 0 then break end

        local p = bot:point()
        if not p then break end

        local tiles = {
            Vector2i.new(p.x - 1, p.y - 1),
            Vector2i.new(p.x - 1, p.y),
            Vector2i.new(p.x - 1, p.y + 1)
        }

        for placeRound = 1, CONFIG.PLACE_COUNT do
            for _, pos in pairs(tiles) do
                inv = bot:inventory()
                block = inv and inv:count(CONFIG.ITEM_ID, InventoryItemType.block) or 0
                if block <= 0 then break end

                local world = bot:world()
                local tile = world and world:tile(pos)

                if tile and tile.foreground == 0 then
                    pcall(function()
                        bot:place(pos, CONFIG.ITEM_ID, InventoryItemType.block)
                    end)

                    sleep(CONFIG.PLACE_DELAY)
                    rsleep()
                end
            end
        end

        for hitRound = 1, CONFIG.HIT_COUNT do
            for _, pos in pairs(tiles) do
                pcall(function()
                    bot:hit(pos)
                end)

                sleep(CONFIG.HIT_DELAY)
                rsleep()
            end
        end

        collectNearby(bot)
    end
end

local function dropSeed(bot, rowY)
    local inv = bot:inventory()
    local seed = inv and inv:count(CONFIG.ITEM_ID, InventoryItemType.seed) or 0
    if seed <= CONFIG.KEEP_SEED then return end

    pathTo(bot, CONFIG.DROP_X, CONFIG.DROP_Y)

    pcall(function()
        bot:drop(CONFIG.ITEM_ID, InventoryItemType.seed, seed - CONFIG.KEEP_SEED)
    end)

    sleep(1000)
    pathTo(bot, CONFIG.START_X, rowY)
end

local function waitReady(bot, rowY)
    while true do
        ensureFarm(bot)

        local world = bot:world()

        if world then
            for x = 1, world.size.x - 2 do
                local tile = world:tile(Vector2i.new(x, rowY))

                if tile and tile.foreground ~= 0 then
                    local tree = tile:tree()

                    if tree and tree:ready() then
                        return
                    end
                end
            end
        end

        if hasEmptyTile(bot, rowY) then
            plant(bot, rowY)
            return
        end

        sleep(5000)
    end
end

local function botThread(bot)
    sleep(math.random(CONFIG.BOT_START_MIN, CONFIG.BOT_START_MAX))

    while true do
        ensureFarm(bot)

        local rowY = getRow(bot)

        pathTo(bot, CONFIG.START_X, rowY)
        sleep(CONFIG.START_WAIT)

        pnb(bot, rowY)

        harvest(bot, rowY)
        collectNearby(bot)

        pnb(bot, rowY)

        if hasEmptyTile(bot, rowY) then
            plant(bot, rowY)
        end

        dropSeed(bot, rowY)

        waitReady(bot, rowY)

        sleep(math.random(CONFIG.BOT_THREAD_DELAY_MIN, CONFIG.BOT_THREAD_DELAY_MAX))
    end
end

runThread(function()
    while true do
        for _, bot in pairs(getClients()) do
            if bot and bot.id and not running[bot.id] then
                running[bot.id] = true

                runThread(function()
                    local ok, err = pcall(function()
                        botThread(bot)
                    end)

                    print("[BOT " .. tostring(bot.id) .. "] " .. tostring(err))
                    running[bot.id] = nil
                end)

                sleep(math.random(1500, 3500))
            end
        end

        sleep(1000)
    end
end)
