local client = getClient()

local CONFIG = {
    WORLD = "NOLES:AB",

    ITEM_ID = 5,

    START_X = 1,
    START_Y = 9,

    DROP_X = 3,
    DROP_Y = 3,

    DROP_LIMIT = 30,
    DROP_COUNT = 20,

    PNB_BLOCK_LIMIT = 999,

    HIT_COUNT = 3,

    HIT_DELAY = 180,
    PLACE_DELAY = 200,
    TREE_DELAY = 100,
    LOOP_DELAY = 1000,

    PATH_TIMEOUT = 8000,

    COLLECT_RANGE = 6,
    COLLECT_DELAY = 20,

    RAND_MIN = 120,
    RAND_MAX = 60
}

getPreferences().collect = true
getPreferences().collectInterval = 50

local tmpPos = Vector2i.new(0, 0)

local function rsleep()
    sleep(math.random(CONFIG.RAND_MIN, CONFIG.RAND_MAX))
end

local function nav()
    local n = client:navigation()
    return n and tostring(n):upper() or "#MENU"
end

local function worldOnly(w)
    local s = tostring(w):upper()
    local p = string.find(s, ":")

    return p and string.sub(s, 1, p - 1) or s
end

local function joinWorld()
    if string.find(nav(), worldOnly(CONFIG.WORLD), 1, true) then
        return true
    end

    client:warp(CONFIG.WORLD)
    sleep(5000)
    rsleep()

    return string.find(nav(), worldOnly(CONFIG.WORLD), 1, true) ~= nil
end

local function pathTo(pos)
    client:findPath(pos)

    local timeout = 0

    while client:pathfinding() do
        sleep(50)
        timeout = timeout + 50

        if timeout >= CONFIG.PATH_TIMEOUT then
            client:clearPath()
            return false
        end
    end

    rsleep()

    return true
end

local function getBlockCount()
    local inv = client:inventory()
    return inv and inv:count(CONFIG.ITEM_ID, InventoryItemType.block) or 0
end

local function collectNearby(centerPos)
    local world = client:world()
    if not world then return end

    for _, obj in pairs(world.collectables) do
        local op = obj:point()

        local dist =
            math.abs(centerPos.x - op.x) +
            math.abs(centerPos.y - op.y)

        if dist <= CONFIG.COLLECT_RANGE then
            pcall(function()
                client:collect(obj.id)
            end)

            sleep(CONFIG.COLLECT_DELAY)
            rsleep()
        end
    end
end

local function isSolid(tile)
    return tile
        and tile.foreground ~= 0
        and tile.foreground % 2 == 0
end

local function isHarvestable(tile)
    if not tile or tile.foreground == 0 then
        return false
    end

    local tree = tile:tree()
    return tree and tree:ready()
end

local function doHarvest()
    local world = client:world()
    if not world then return end

    for y = world.size.y - 2, 1, -1 do
        for x = 1, world.size.x - 2 do
            local pos = Vector2i.new(x, y)
            local tile = world:tile(pos)

            if isHarvestable(tile) then
                local myPos = client:point()

                local dist =
                    math.abs(myPos.x - x) +
                    math.abs(myPos.y - y)

                if dist > 2 then
                    if not pathTo(pos) then
                        goto continue
                    end
                end

                repeat
                    client:hit(pos)
                    sleep(CONFIG.HIT_DELAY)
                    rsleep()

                    tile = world:tile(pos)
                until not tile or tile.foreground == 0

                collectNearby(pos)

                sleep(CONFIG.TREE_DELAY)
                rsleep()
            end

            ::continue::
        end
    end
end

local function doPlantAll()
    local world = client:world()
    if not world then return end

    for _, tile in pairs(world.tiles) do
        local point = tile:point()
        local px, py = point.x, point.y

        tmpPos.x = px
        tmpPos.y = py + 1

        local below = world:tile(tmpPos)

        if tile.foreground == 0 and isSolid(below) then
            local inv = client:inventory()
            local seed =
                inv and inv:count(CONFIG.ITEM_ID, InventoryItemType.seed) or 0

            if seed <= 0 then
                break
            end

            tmpPos.x = px
            tmpPos.y = py

            if pathTo(tmpPos) then
                client:place(
                    tmpPos,
                    CONFIG.ITEM_ID,
                    InventoryItemType.seed
                )

                sleep(CONFIG.PLACE_DELAY)
                rsleep()
            end
        end
    end
end

local function doPNB()
    local startPos = Vector2i.new(
        CONFIG.START_X,
        CONFIG.START_Y
    )

    while true do
        local block = getBlockCount()

        if block <= 0 then
            break
        end

        pathTo(startPos)

        local p = client:point()
        if not p then break end

        local targets = {
            Vector2i.new(p.x - 1, p.y - 1),
            Vector2i.new(p.x - 1, p.y),
            Vector2i.new(p.x - 1, p.y + 1)
        }

        local world = client:world()
        if not world then break end

        for _, pos in ipairs(targets) do
            block = getBlockCount()
            if block <= 0 then break end

            local tile = world:tile(pos)

            if tile and tile.foreground == 0 then
                client:place(
                    pos,
                    CONFIG.ITEM_ID,
                    InventoryItemType.block
                )

                sleep(CONFIG.PLACE_DELAY)
                rsleep()
            end
        end

        for _, pos in ipairs(targets) do
            for i = 1, CONFIG.HIT_COUNT do
                client:hit(pos)
                sleep(CONFIG.HIT_DELAY)
                rsleep()
            end
        end

        collectNearby(p)
        rsleep()
    end
end

local function doDrop()
    local dropPos = Vector2i.new(
        CONFIG.DROP_X,
        CONFIG.DROP_Y
    )

    pathTo(dropPos)

    local inv = client:inventory()
    if not inv then return end

    for _, item in pairs(inv.items) do
        if item and item.id then
            if item.id == CONFIG.ITEM_ID
            and item.type == InventoryItemType.seed then
                if item.amount >= CONFIG.DROP_LIMIT then
                    client:drop(
                        item.id,
                        InventoryItemType.seed,
                        CONFIG.DROP_COUNT
                    )

                    sleep(300)
                    rsleep()
                end

            elseif item.type == InventoryItemType.consumable then
                client:drop(
                    item.id,
                    InventoryItemType.consumable,
                    item.amount
                )

                sleep(300)
                rsleep()
            end
        end
    end
end

runThread(function()
    while true do
        if joinWorld() then
            doHarvest()
            rsleep()

            doPlantAll()
            rsleep()

            if getBlockCount() >= CONFIG.PNB_BLOCK_LIMIT then
                pathTo(Vector2i.new(
                    CONFIG.START_X,
                    CONFIG.START_Y
                ))

                doPNB()
            end

            rsleep()
            doDrop()
        end

        sleep(CONFIG.LOOP_DELAY)
        rsleep()
    end
end)
