-- AUTO PABRIK ADVANCE SIMPLE FINAL
-- PNB: 3 block samping kiri player
-- Collect: area sekitar player

local CONFIG = {
    FARM_WORLD = "NOLES",
    FARM_DOOR  = "AB",

    SEED_ID  = 3,
    BLOCK_ID = 3,

    SEED_TYPE = "seed",
    BLOCK_TYPE = "block",
    EXCLUSIVE_TYPE = "consumable",

    START_X = 1,
    START_Y = 9,
    BOT_Y_STEP = 4,

    WORLD_WIDTH = 25,

    KEEP_SEED = 25,

    EXCLUSIVE = {
        3364,
        3365,
        3366,
        1137,
        1136
    },

    MOVE_DELAY = 1200,
    WARP_DELAY = 5000,
    PATH_TIMEOUT = 12000,

    HIT_DELAY = 180,
    PLACE_DELAY = 160,
    COLLECT_DELAY = 180,

    LOOP_DELAY = 3000,
    READY_WAIT = 20000,

    COLLECT_RADIUS = 3,
}

local running = {}

local function invCount(bot, id, typ)
    local inv = bot:inventory()
    if not inv then return 0 end
    return inv:count(id, typ)
end

local function nav(bot)
    local n = bot:navigation()
    if not n then return "" end
    return tostring(n):upper()
end

local function targetWorld()
    return tostring(CONFIG.FARM_WORLD):upper()
end

local function warpFarm(bot)
    local world = targetWorld()
    local warpName = world

    if CONFIG.FARM_DOOR and CONFIG.FARM_DOOR ~= "" then
        warpName = world .. ":" .. CONFIG.FARM_DOOR
    end

    if nav(bot) ~= world then
        bot:warp(warpName)
        sleep(CONFIG.WARP_DELAY)
    end

    return nav(bot) == world
end

local function goTile(bot, x, y)
    local p = bot:point()
    if p and p.x == x and p.y == y then return true end

    bot:clearPath()
    sleep(100)

    local ok = bot:findPath(Vector2i.new(x, y))
    if ok == false then return false end

    local t = 0
    while bot:pathfinding() and t < CONFIG.PATH_TIMEOUT do
        sleep(100)
        t = t + 100
    end

    p = bot:point()
    return p and p.x == x and p.y == y
end

local function getBotIndex(target)
    local bots = {}

    for _, b in pairs(getClients()) do
        if b and b.id then
            table.insert(bots, b)
        end
    end

    table.sort(bots, function(a, b)
        return tostring(a.id) < tostring(b.id)
    end)

    for i, b in ipairs(bots) do
        if b.id == target.id then
            return i
        end
    end

    return 1
end

local function getStartPos(bot)
    local index = getBotIndex(bot)

    return {
        x = CONFIG.START_X,
        y = CONFIG.START_Y + ((index - 1) * CONFIG.BOT_Y_STEP)
    }
end

local function collectNear(bot)
    local w = bot:world()
    local p = bot:point()
    if not w or not p then return end

    for _, obj in pairs(w.collectables) do
        if obj then
            local op = obj:point()
            if op then
                if math.abs(op.x - p.x) <= CONFIG.COLLECT_RADIUS and
                   math.abs(op.y - p.y) <= CONFIG.COLLECT_RADIUS then
                    pcall(function()
                        bot:collect(obj.id)
                    end)
                    sleep(CONFIG.COLLECT_DELAY)
                end
            end
        end
    end
end

local function dropExtra(bot)
    local seed = invCount(bot, CONFIG.SEED_ID, CONFIG.SEED_TYPE)

    if seed > CONFIG.KEEP_SEED then
        bot:drop(CONFIG.SEED_ID, CONFIG.SEED_TYPE, seed - CONFIG.KEEP_SEED)
        sleep(700)
    end

    for _, id in ipairs(CONFIG.EXCLUSIVE) do
        local c = invCount(bot, id, CONFIG.EXCLUSIVE_TYPE)
        if c > 0 then
            bot:drop(id, CONFIG.EXCLUSIVE_TYPE, c)
            sleep(700)
        end
    end
end

local function harvestRow(bot, rowY)
    local w = bot:world()
    if not w then return end

    for x = 0, CONFIG.WORLD_WIDTH - 1 do
        local tile = w:tile(Vector2i.new(x, rowY))
        if tile then
            local tree = tile:tree()
            if tree and tree.blockType == CONFIG.SEED_ID and tree:ready() then
                if goTile(bot, x, rowY) then
                    bot:hit(Vector2i.new(x, rowY))
                    sleep(CONFIG.HIT_DELAY)
                    collectNear(bot)
                end
            end
        end
    end
end

local function plantRow(bot, rowY)
    if invCount(bot, CONFIG.SEED_ID, CONFIG.SEED_TYPE) <= 0 then return end

    local w = bot:world()
    if not w then return end

    for x = 0, CONFIG.WORLD_WIDTH - 1 do
        local tile = w:tile(Vector2i.new(x, rowY))
        local below = w:tile(Vector2i.new(x, rowY + 1))

        if tile and below and tile.foreground == 0 and below.foreground ~= 0 then
            if goTile(bot, x, rowY) then
                bot:place(Vector2i.new(x, rowY), CONFIG.SEED_ID, CONFIG.SEED_TYPE)
                sleep(CONFIG.PLACE_DELAY)
            end
        end
    end
end

local function pnbRow(bot, rowY)
    local w = bot:world()
    if not w then return end

    for x = 1, CONFIG.WORLD_WIDTH - 1 do
        local standX = x
        local standY = rowY

        if goTile(bot, standX, standY) then
            local targets = {
                Vector2i.new(x - 1, rowY - 1),
                Vector2i.new(x - 1, rowY),
                Vector2i.new(x - 1, rowY + 1),
            }

            for _, pos in ipairs(targets) do
                local tile = w:tile(pos)
                if tile and tile.foreground == CONFIG.BLOCK_ID then
                    bot:hit(pos)
                    sleep(CONFIG.HIT_DELAY)
                    collectNear(bot)
                end
            end
        end
    end
end

local function botThread(bot)
    while true do
        if not bot or not bot.id then break end

        if not bot:connected() then
            bot:connect()
            sleep(CONFIG.WARP_DELAY)
        end

        if warpFarm(bot) then
            local start = getStartPos(bot)

            if goTile(bot, start.x, start.y) then
                harvestRow(bot, start.y)
                collectNear(bot)

                plantRow(bot, start.y)
                collectNear(bot)

                pnbRow(bot, start.y)
                collectNear(bot)

                goTile(bot, start.x, start.y)
                dropExtra(bot)

                sleep(CONFIG.READY_WAIT)
            else
                sleep(CONFIG.LOOP_DELAY)
            end
        else
            sleep(CONFIG.WARP_DELAY)
        end

        sleep(CONFIG.LOOP_DELAY)
    end

    if bot and bot.id then
        running[bot.id] = nil
    end
end

runThread(function()
    while true do
        for _, bot in pairs(getClients()) do
            if bot and bot.id and not running[bot.id] then
                running[bot.id] = true
                runThread(botThread, bot)
                sleep(CONFIG.MOVE_DELAY)
            end
        end

        sleep(3000)
    end
end)
