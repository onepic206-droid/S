-- AUTO PABRIK ADVANCE MULTI BOT LIGHT AUTO FINAL

local CONFIG = {
    FARM_WORLD = "NOLES:AB",

    ITEM_ID = 5,

    START_X = 1,
    START_Y = 9,
    BOT_Y_STEP = 4,

    DROP_X = 3,
    DROP_Y = 3,

    KEEP_SEED = 50,

    EXCLUSIVE_CONSUMABLE = {
        3364, 3365, 3366, 1134
    },

    PNB_BLOCK_COUNT = 3,
    PNB_HIT_ROUND = 3,

    PLANT_DELAY_MIN = 180,
    PLANT_DELAY_MAX = 330,

    PLACE_DELAY_MIN = 180,
    PLACE_DELAY_MAX = 320,

    HIT_DELAY_MIN = 180,
    HIT_DELAY_MAX = 330,

    HARVEST_HIT_DELAY_MIN = 220,
    HARVEST_HIT_DELAY_MAX = 400,

    NEXT_TILE_DELAY_MIN = 120,
    NEXT_TILE_DELAY_MAX = 260,

    CYCLE_IDLE_MIN = 800,
    CYCLE_IDLE_MAX = 1600,

    HUMAN_PAUSE_CHANCE = 12,
    HUMAN_PAUSE_MIN = 2500,
    HUMAN_PAUSE_MAX = 6000,

    PATH_TIMEOUT = 8000,

    COLLECT_RANGE = 5,
    COLLECT_LIMIT = 12,
    COLLECT_EVERY_PNB_LOOP = 4,

    WAIT_TREE_DELAY = 7000,

    WARP_CHECK_TIMEOUT = 20000,
    RECONNECT_DELAY = 10000,

    mainDelay = 1200,
    moveDelay = 300
}

local running = {}

math.randomseed(math.random(100000, 999999))

local function rsleep(a, b)
    sleep(math.random(a, b))
end

local function humanPause()
    if math.random(1, CONFIG.HUMAN_PAUSE_CHANCE) == 1 then
        rsleep(CONFIG.HUMAN_PAUSE_MIN, CONFIG.HUMAN_PAUSE_MAX)
    end
end

local function log(bot, msg)
    print("[BOT " .. tostring(bot and bot.id or "?") .. "] " .. tostring(msg))
end

local function worldOnly(w)
    local s = tostring(w or ""):upper()
    local p = string.find(s, ":")
    if p then return string.sub(s, 1, p - 1) end
    return s
end

local FARM_ONLY = worldOnly(CONFIG.FARM_WORLD)

local function nav(bot)
    local n = bot:navigation()
    if not n then return "#MENU" end
    return tostring(n):upper()
end

local function isInFarm(bot)
    local n = nav(bot)
    return n == FARM_ONLY or string.find(n, FARM_ONLY, 1, true) ~= nil
end

local function isServerFull(bot)
    return bot.status == GameClientStatus.serverFull
end

local function ensureConnected(bot)
    while true do
        local ok, con = pcall(function()
            return bot:connected()
        end)

        if ok and con and not isServerFull(bot) then
            return true
        end

        log(bot, "Reconnect / server full")

        pcall(function()
            bot:disconnect()
        end)

        sleep(2000)

        pcall(function()
            bot:connect()
        end)

        sleep(CONFIG.RECONNECT_DELAY)
    end
end

local function forceFarm(bot)
    ensureConnected(bot)

    if isInFarm(bot) then
        return true
    end

    while true do
        ensureConnected(bot)

        if isInFarm(bot) then
            return true
        end

        log(bot, "Warp -> " .. CONFIG.FARM_WORLD)

        pcall(function()
            bot:warp(CONFIG.FARM_WORLD)
        end)

        local t = 0

        while t < CONFIG.WARP_CHECK_TIMEOUT do
            ensureConnected(bot)

            if isInFarm(bot) then
                return true
            end

            if nav(bot) == "#MENU" or isServerFull(bot) then
                break
            end

            sleep(500)
            t = t + 500
        end

        pcall(function()
            bot:disconnect()
        end)

        sleep(2000)

        pcall(function()
            bot:connect()
        end)

        sleep(CONFIG.RECONNECT_DELAY)
    end
end

local function samePoint(bot, x, y)
    local p = bot:point()
    return p and p.x == x and p.y == y
end

local function pathTo(bot, pos)
    if not bot or not pos then return false end

    if samePoint(bot, pos.x, pos.y) then
        return true
    end

    if not isInFarm(bot) then
        forceFarm(bot)
    end

    pcall(function()
        bot:clearPath()
    end)

    sleep(120)

    local ok = bot:findPath(pos)
    if ok == false then return false end

    local t = 0

    while bot:pathfinding() and t < CONFIG.PATH_TIMEOUT do
        if nav(bot) == "#MENU" then
            forceFarm(bot)
            return false
        end

        sleep(60)
        t = t + 60
    end

    if t >= CONFIG.PATH_TIMEOUT then
        pcall(function()
            bot:clearPath()
        end)
        return false
    end

    return samePoint(bot, pos.x, pos.y)
end

local function goToTile(bot, x, y)
    return pathTo(bot, Vector2i.new(x, y))
end

local function getBotIndex(target)
    local bots = {}

    for _, b in pairs(getClients()) do
        if b and b.id then
            table.insert(bots, b)
        end
    end

    table.sort(bots, function(a, b)
        return tostring(a.id) < tostring(b.id)
    end)

    for i, b in ipairs(bots) do
        if b.id == target.id then
            return i
        end
    end

    return 1
end

local function getStartPosByIndex(index)
    return Vector2i.new(
        CONFIG.START_X,
        CONFIG.START_Y + ((index - 1) * CONFIG.BOT_Y_STEP)
    )
end

local function setupBot(bot)
    pcall(function()
        bot:preferences().collect = false
        bot:preferences().collectInterval = 120
        bot:preferences().reconnect = true
        bot:preferences().reconnectInterval = 10000
    end)
end

local function invCount(bot, id, typ)
    local inv = bot:inventory()
    if not inv then return 0 end
    return inv:count(id, typ) or 0
end

local function collectNearby(bot, center)
    local world = bot:world()
    if not world or not center then return end

    local picked = 0

    for _, obj in pairs(world.collectables) do
        if picked >= CONFIG.COLLECT_LIMIT then
            break
        end

        local op = obj:point()

        if op then
            local dist = math.abs(center.x - op.x) + math.abs(center.y - op.y)

            if dist <= CONFIG.COLLECT_RANGE then
                pcall(function()
                    bot:collect(obj.id)
                end)

                picked = picked + 1
                sleep(40)
            end
        end
    end
end

local function isHarvestable(tile)
    if not tile or tile.foreground == 0 then return false end
    local tree = tile:tree()
    return tree and tree:ready()
end

local function canPlant(world, x, y)
    local tile = world:tile(Vector2i.new(x, y))
    local below = world:tile(Vector2i.new(x, y + 1))

    return tile and below and tile.foreground == 0 and below.foreground ~= 0
end

local function rowHasAny(bot, rowY)
    local world = bot:world()
    if not world then return false end

    for x = 1, world.size.x - 2, 2 do
        local tile = world:tile(Vector2i.new(x, rowY))
        if tile and tile.foreground ~= 0 then
            return true
        end
    end

    return false
end

local function rowHasReady(bot, rowY)
    local world = bot:world()
    if not world then return false end

    for x = 1, world.size.x - 2, 2 do
        local tile = world:tile(Vector2i.new(x, rowY))
        if isHarvestable(tile) then
            return true
        end
    end

    return false
end

local function plantOne(bot, x, y)
    if invCount(bot, CONFIG.ITEM_ID, InventoryItemType.seed) <= 0 then
        return false
    end

    local world = bot:world()
    if not world or not canPlant(world, x, y) then
        return false
    end

    local pos = Vector2i.new(x, y)

    if not samePoint(bot, x, y) then
        pathTo(bot, pos)
    end

    rsleep(70, 150)

    world = bot:world()

    if world and canPlant(world, x, y) then
        pcall(function()
            bot:place(pos, CONFIG.ITEM_ID, InventoryItemType.seed)
        end)

        rsleep(CONFIG.PLANT_DELAY_MIN, CONFIG.PLANT_DELAY_MAX)
        return true
    end

    return false
end

local function plantEmptyRow(bot, rowY)
    if not isInFarm(bot) then
        forceFarm(bot)
    end

    local world = bot:world()
    if not world then return end

    log(bot, "Plant row -> " .. rowY)

    for x = 1, world.size.x - 2 do
        if nav(bot) == "#MENU" then
            forceFarm(bot)
            return
        end

        if invCount(bot, CONFIG.ITEM_ID, InventoryItemType.seed) <= 0 then
            return
        end

        plantOne(bot, x, rowY)
        rsleep(CONFIG.NEXT_TILE_DELAY_MIN, CONFIG.NEXT_TILE_DELAY_MAX)
    end
end

local function harvestRowOnly(bot, rowY)
    if not isInFarm(bot) then
        forceFarm(bot)
    end

    local world = bot:world()
    if not world then return end

    log(bot, "Harvest row -> " .. rowY)

    for x = 1, world.size.x - 2 do
        if nav(bot) == "#MENU" then
            forceFarm(bot)
            return
        end

        world = bot:world()
        if not world then return end

        local pos = Vector2i.new(x, rowY)
        local tile = world:tile(pos)

        if isHarvestable(tile) then
            pathTo(bot, pos)

            for i = 1, 8 do
                world = bot:world()
                tile = world and world:tile(pos)

                if not tile or tile.foreground == 0 then
                    break
                end

                pcall(function()
                    bot:hit(pos)
                end)

                rsleep(CONFIG.HARVEST_HIT_DELAY_MIN, CONFIG.HARVEST_HIT_DELAY_MAX)
            end

            collectNearby(bot, pos)
            rsleep(CONFIG.NEXT_TILE_DELAY_MIN, CONFIG.NEXT_TILE_DELAY_MAX)
        end
    end

    rsleep(CONFIG.CYCLE_IDLE_MIN, CONFIG.CYCLE_IDLE_MAX)
end

local function makePnbTiles(bot)
    local p = bot:point()
    local tiles = {}

    if not p then return tiles end

    local half = math.floor(CONFIG.PNB_BLOCK_COUNT / 2)

    for i = 0, CONFIG.PNB_BLOCK_COUNT - 1 do
        local y = p.y - half + i
        table.insert(tiles, Vector2i.new(p.x - 1, y))
    end

    return tiles
end

local function placePnbBlocks(bot, tiles)
    for _, pos in ipairs(tiles) do
        if invCount(bot, CONFIG.ITEM_ID, InventoryItemType.block) <= 0 then
            return
        end

        local world = bot:world()
        local tile = world and world:tile(pos)

        if tile and tile.foreground == 0 then
            rsleep(70, 150)

            world = bot:world()
            tile = world and world:tile(pos)

            if tile and tile.foreground == 0 then
                pcall(function()
                    bot:place(pos, CONFIG.ITEM_ID, InventoryItemType.block)
                end)

                rsleep(CONFIG.PLACE_DELAY_MIN, CONFIG.PLACE_DELAY_MAX)
            end
        end
    end
end

local function hitPnbBlocks(bot, tiles)
    for r = 1, CONFIG.PNB_HIT_ROUND do
        for _, pos in ipairs(tiles) do
            local world = bot:world()
            local tile = world and world:tile(pos)

            if tile and tile.foreground ~= 0 then
                pcall(function()
                    bot:hit(pos)
                end)

                rsleep(CONFIG.HIT_DELAY_MIN, CONFIG.HIT_DELAY_MAX)
            else
                sleep(70)
            end
        end
    end
end

local function pnb(bot, start)
    if not isInFarm(bot) then
        forceFarm(bot)
    end

    goToTile(bot, start.x, start.y)

    log(bot, "PNB start")

    local loop = 0

    while true do
        if nav(bot) == "#MENU" then
            forceFarm(bot)
            goToTile(bot, start.x, start.y)
        end

        local block = invCount(bot, CONFIG.ITEM_ID, InventoryItemType.block)

        if block <= 0 then
            log(bot, "PNB done")
            return
        end

        if not samePoint(bot, start.x, start.y) then
            goToTile(bot, start.x, start.y)
        end

        local tiles = makePnbTiles(bot)

        placePnbBlocks(bot, tiles)
        hitPnbBlocks(bot, tiles)

        loop = loop + 1

        if loop % CONFIG.COLLECT_EVERY_PNB_LOOP == 0 then
            collectNearby(bot, bot:point())
        end

        rsleep(CONFIG.CYCLE_IDLE_MIN, CONFIG.CYCLE_IDLE_MAX)
        humanPause()
    end
end

local function pnbIfBlock(bot, start)
    if invCount(bot, CONFIG.ITEM_ID, InventoryItemType.block) > 0 then
        pnb(bot, start)
    end
end

local function dropItem(bot, id, invType, amount)
    if amount and amount > 0 then
        log(bot, "Drop -> " .. id .. " x" .. amount)

        pcall(function()
            bot:drop(id, invType, amount)
        end)

        rsleep(800, 1300)
    end
end

local function hasDropItem(bot)
    local seed = invCount(bot, CONFIG.ITEM_ID, InventoryItemType.seed)

    if seed > CONFIG.KEEP_SEED then
        return true
    end

    for _, id in pairs(CONFIG.EXCLUSIVE_CONSUMABLE) do
        if invCount(bot, id, InventoryItemType.consumable) > 0 then
            return true
        end
    end

    return false
end

local function dropExtra(bot, start)
    if not hasDropItem(bot) then return end

    if not isInFarm(bot) then
        forceFarm(bot)
    end

    log(bot, "Drop extra")

    goToTile(bot, CONFIG.DROP_X, CONFIG.DROP_Y)
    rsleep(700, 1200)

    local seed = invCount(bot, CONFIG.ITEM_ID, InventoryItemType.seed)

    if seed > CONFIG.KEEP_SEED then
        dropItem(bot, CONFIG.ITEM_ID, InventoryItemType.seed, seed - CONFIG.KEEP_SEED)
    end

    for _, id in pairs(CONFIG.EXCLUSIVE_CONSUMABLE) do
        local amount = invCount(bot, id, InventoryItemType.consumable)

        if amount > 0 then
            dropItem(bot, id, InventoryItemType.consumable, amount)
        end
    end

    if start then
        goToTile(bot, start.x, start.y)
    end
end

local function waitTreeReady(bot, rowY)
    log(bot, "Wait tree ready -> " .. rowY)

    while true do
        if not isInFarm(bot) then
            forceFarm(bot)
        end

        if rowHasReady(bot, rowY) then
            return
        end

        if not rowHasAny(bot, rowY) then
            if invCount(bot, CONFIG.ITEM_ID, InventoryItemType.seed) > 0 then
                plantEmptyRow(bot, rowY)
                return
            end
        end

        sleep(CONFIG.WAIT_TREE_DELAY)
    end
end

local function botThread(bot)
    setupBot(bot)

    local index = getBotIndex(bot)
    local start = getStartPosByIndex(index)
    local rowY = start.y

    log(bot, "Assigned row -> " .. rowY)

    while true do
        forceFarm(bot)

        log(bot, "Cycle start row -> " .. rowY)

        goToTile(bot, start.x, start.y)

        if not rowHasAny(bot, rowY) then
            plantEmptyRow(bot, rowY)
            goToTile(bot, start.x, start.y)
        end

        pnbIfBlock(bot, start)

        harvestRowOnly(bot, rowY)

        collectNearby(bot, bot:point())

        plantEmptyRow(bot, rowY)

        goToTile(bot, start.x, start.y)

        pnbIfBlock(bot, start)

        collectNearby(bot, bot:point())

        dropExtra(bot, start)

        waitTreeReady(bot, rowY)

        humanPause()

        log(bot, "Cycle done")
        sleep(CONFIG.mainDelay)
    end
end

runThread(function()
    while true do
        local bots = getClients()

        for _, bot in pairs(bots) do
            if bot and bot.id and not running[bot.id] then
                running[bot.id] = true

                print("[MANAGER] Start bot -> " .. tostring(bot.id))

                runThread(function()
                    local ok, err = pcall(function()
                        botThread(bot)
                    end)

                    print("[BOT " .. tostring(bot.id) .. "] Thread error -> " .. tostring(err))
                    running[bot.id] = nil
                end)

                sleep(CONFIG.moveDelay)
            end
        end

        sleep(CONFIG.mainDelay)
    end
end)
