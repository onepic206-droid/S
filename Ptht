local client = getClient()

local PlantID = 25
local delayPlant = 100
local msPerTilePlant  = 150
local msPerTileNormal = 50

local function isSolid(tile)
    return tile and tile.foreground ~= 0 and tile.foreground % 2 == 0
end

local function hasSeed()
    local inv = client:inventory()
    return inv:count(PlantID, InventoryItemType.seed) > 0
end

local function walkTo(pos, msPerTile)
    local path = client:getPath(pos)
    local pathLen = (path and #path > 0) and #path or 1

    client:findPath(pos)

    local totalWait = pathLen * msPerTile
    local elapsed = 0
    while elapsed < totalWait and client:pathfinding() do
        sleep(50)
        elapsed = elapsed + 50
    end

    repeat sleep(10) until not client:pathfinding()
end

runThread(function()
    local world = client:world()
    if not world then
        client:logger():add("World nil!")
        return
    end

    local rows = {}
    local pos = Vector2i.new(0, 0)

    for _, tile in pairs(world.tiles) do
        local point = tile:point()
        local px, py = point.x, point.y

        -- Cek tile bawah (Y+1 karena Y ke bawah)
        pos.x = px
        pos.y = py + 1
        local below = world:tile(pos)

        if tile.foreground == 0 and isSolid(below) then
            if not rows[py] then rows[py] = {} end
            table.insert(rows[py], px)
        end
    end

    -- Sort Y dari kecil ke besar (atas ke bawah)
    local sortedY = {}
    for y, _ in pairs(rows) do
        table.insert(sortedY, y)
    end
    table.sort(sortedY, function(a, b) return a < b end)

    -- Zigzag: baris pertama kiri→kanan, berikutnya kanan→kiri, dst
    local targets = {}
    local leftToRight = true

    for _, y in ipairs(sortedY) do
        local row = rows[y]

        -- Selalu sort X ascending dulu
        table.sort(row, function(a, b) return a < b end)

        if leftToRight then
            -- Kiri ke kanan
            for _, x in ipairs(row) do
                table.insert(targets, { x = x, y = y })
            end
        else
            -- Kanan ke kiri
            for i = #row, 1, -1 do
                table.insert(targets, { x = row[i], y = y })
            end
        end

        leftToRight = not leftToRight
    end

    client:logger():add("Total targets: " .. #targets)

    -- Debug: log 3 target pertama
    for i = 1, math.min(3, #targets) do
        client:logger():add("Target " .. i .. ": x=" .. targets[i].x .. " y=" .. targets[i].y)
    end

    local currentY = nil

    for _, t in ipairs(targets) do
        if not hasSeed() then
            client:logger():add("Seed habis, berhenti.")
            break
        end

        pos.x = t.x
        pos.y = t.y

        if currentY ~= t.y then
            -- Pindah baris: move normal (cepat)
            walkTo(pos, msPerTileNormal)
            currentY = t.y
        else
            -- Dalam baris: move plant (pelan)
            walkTo(pos, msPerTilePlant)
        end

        client:place(pos, PlantID, InventoryItemType.seed)
        sleep(delayPlant)
    end

    client:logger():add("Selesai planting!")
end)
