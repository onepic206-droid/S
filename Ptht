local client = getClient()

Config = {
    WORLD = "NAMAWORLD:ID",

    MODE = "PLANT", -- "HT" / "PLANT" / "BOTH"

    ITEM_ID = 5,

    HIT_DELAY = 180,
    TREE_DELAY = 200,
    PLANT_DELAY = 80,
    LOOP_DELAY = 1000,

    RAND_MIN = 80,
    RAND_MAX = 150,

    DROP_X = 40,
    DROP_Y = 3,

    MAX_AMOUNT = 999,

    PATH_TIMEOUT = 5000,
    PATH_CHECK = 50,

    PLANT_LINE = 5
}

local function rsleep(base)
    sleep(base + math.random(Config.RAND_MIN, Config.RAND_MAX))
end

local function getWorldName()
    local w = client:world()
    return w and w.id or ""
end

local function joinWorld()
    client:warp(Config.WORLD)

    repeat
        sleep(1000)
    until client:world() ~= nil
end

local function pathTo(pos)
    local p = client:point()
    if p and p.x == pos.x and p.y == pos.y then
        return true
    end

    client:findPath(pos)

    local t = 0
    while client:pathfinding() and t < Config.PATH_TIMEOUT do
        sleep(Config.PATH_CHECK)
        t = t + Config.PATH_CHECK
    end

    if client:pathfinding() then
        client:clearPath()
        return false
    end

    p = client:point()
    return p
        and math.abs(p.x - pos.x) <= 1
        and math.abs(p.y - pos.y) <= 1
end

local function getCount(id, itemType)
    local inv = client:inventory()
    if not inv then return 0 end
    return inv:count(id, itemType) or 0
end

local function isSolid(tile)
    return tile and tile.foreground ~= 0 and tile.foreground % 2 == 0
end

local function isHarvestable(tile)
    if not tile or tile.foreground == 0 then
        return false
    end

    local tree = tile:tree()
    return tree and tree:ready()
end

local function collectNearby(center)
    local world = client:world()
    if not world then return end

    for _, obj in pairs(world.collectables) do
        if obj and obj.point then
            local p = obj:point()

            if math.abs(p.x - center.x) <= 3
                and math.abs(p.y - center.y) <= 3
            then
                pcall(function()
                    client:collect(obj.id)
                end)

                rsleep(80)
            end
        end
    end
end

local function collectSeed()
    local world = client:world()
    if not world then return false end

    for _, obj in pairs(world.collectables) do
        if obj
            and obj.blockType == Config.ITEM_ID
            and obj.inventoryType == InventoryItemType.seed
        then
            local p = obj:point()

            if pathTo(p) then
                pcall(function()
                    client:collect(obj.id)
                end)

                rsleep(100)
                return true
            end
        end
    end

    return false
end

local function dropItem(id, itemType, amount)
    if amount <= 0 then return end

    if pathTo(Vector2i.new(Config.DROP_X, Config.DROP_Y)) then
        rsleep(300)
        client:drop(id, itemType, amount)
        rsleep(500)
    end
end

local function checkDrop()
    local blockCount = getCount(Config.ITEM_ID, InventoryItemType.block)

    if blockCount >= Config.MAX_AMOUNT then
        dropItem(Config.ITEM_ID, InventoryItemType.block, blockCount)
    end
end

local function scanZigZag(callback)
    local world = client:world()
    if not world then return end

    local left = 1
    local right = world.size.x - 2
    local top = 1
    local bottom = world.size.y - 2
    local leftToRight = true

    for y = top, bottom do
        if leftToRight then
            for x = left, right do
                callback(world, x, y)
            end
        else
            for x = right, left, -1 do
                callback(world, x, y)
            end
        end

        leftToRight = not leftToRight
    end
end

local function harvestWorld()
    scanZigZag(function(world, x, y)
        checkDrop()

        local treePos = Vector2i.new(x, y)
        local tile = world:tile(treePos)

        if not isHarvestable(tile) then
            return
        end

        local myPos = client:point()
        local dist = math.abs(myPos.x - x) + math.abs(myPos.y - y)

        if dist > 2 then
            if not pathTo(treePos) then
                return
            end
        end

        local hitTry = 0

        repeat
            client:hit(treePos)
            rsleep(Config.HIT_DELAY)

            tile = world:tile(treePos)
            hitTry = hitTry + 1
        until not tile or tile.foreground == 0 or hitTry >= 10

        collectNearby(treePos)
        checkDrop()

        rsleep(Config.TREE_DELAY)
    end)
end

local function plantLine(world, startX, y)
    local seedCount = getCount(Config.ITEM_ID, InventoryItemType.seed)
    if seedCount <= 0 then return end

    local planted = 0

    for i = 0, Config.PLANT_LINE - 1 do
        local x = startX + i

        if x >= world.size.x - 1 then
            break
        end

        local pos = Vector2i.new(x, y)
        local tile = world:tile(pos)
        local below = world:tile(Vector2i.new(x, y + 1))

        if tile and tile.foreground == 0 and isSolid(below) then
            client:place(
                pos,
                Config.ITEM_ID,
                InventoryItemType.seed
            )

            planted = planted + 1
            rsleep(Config.PLANT_DELAY)

            if planted >= seedCount then
                break
            end
        end
    end
end

local function plantWorld()
    local world = client:world()
    if not world then return end

    for y = 1, world.size.y - 2 do
        local x = 1

        while x <= world.size.x - 2 do
            checkDrop()

            if getCount(Config.ITEM_ID, InventoryItemType.seed) <= 0 then
                collectSeed()
                return
            end

            local target = Vector2i.new(x, y)

            if pathTo(target) then
                plantLine(world, x, y)
            end

            x = x + Config.PLANT_LINE
            rsleep(Config.TREE_DELAY)
        end
    end
end

runThread(function()
    joinWorld()

    while true do
        if not client:world() then
            joinWorld()
        end

        checkDrop()

        if Config.MODE == "HT" then
            harvestWorld()

        elseif Config.MODE == "PLANT" then
            plantWorld()

        elseif Config.MODE == "BOTH" then
            harvestWorld()
            plantWorld()
        end

        rsleep(Config.LOOP_DELAY)
    end
end)
