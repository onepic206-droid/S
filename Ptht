local client = getClient()

local Config = {
    MODE = "harvest", -- "plant" / "harvest"

    WORLD = "WORLDNAME",
    DOOR = "",

    PLANT_ID = 5,
    TREE_ID = 5,

    DROP_X = 10,
    DROP_Y = 10,
    DROP_AT = 999,

    WARP_DELAY = 5000,

    DELAY_PLANT = 80,
    HIT_DELAY = 180,
    TREE_DELAY = 100,
    LOOP_DELAY = 1000,

    PATH_TIMEOUT = 8000,

    COLLECT_RANGE = 6,
    COLLECT_DELAY = 20
}

getPreferences().collect = true
getPreferences().collectInterval = 50

local function warp()
    if Config.DOOR ~= "" then
        client:warp(Config.WORLD .. ":" .. Config.DOOR)
    else
        client:warp(Config.WORLD)
    end

    sleep(Config.WARP_DELAY)
end

local function isSolid(tile)
    return tile and tile.foreground ~= 0 and tile.foreground % 2 == 0
end

local function pathTo(pos)
    client:findPath(pos)

    local timeout = 0
    while client:pathfinding() do
        sleep(50)
        timeout = timeout + 50

        if timeout >= Config.PATH_TIMEOUT then
            client:clearPath()
            return false
        end
    end

    return true
end

local function collectNearby(centerPos)
    local world = client:world()
    if not world then return end

    for _, obj in pairs(world.collectables) do
        local objPos = obj:point()

        local dist =
            math.abs(centerPos.x - objPos.x) +
            math.abs(centerPos.y - objPos.y)

        if dist <= Config.COLLECT_RANGE then
            client:collect(obj.id)
            sleep(Config.COLLECT_DELAY)
        end
    end
end

local function getSeedCount()
    return client:inventory():count(Config.PLANT_ID, InventoryItemType.seed)
end

local function dropSeedIfFull()
    local amount = getSeedCount()
    if amount < Config.DROP_AT then return end

    local dropPos = Vector2i.new(Config.DROP_X, Config.DROP_Y)

    if pathTo(dropPos) then
        sleep(200)

        client:drop(
            Config.PLANT_ID,
            InventoryItemType.seed,
            amount
        )

        sleep(500)
    end
end

local function isHarvestable(tile)
    if not tile or tile.foreground == 0 then
        return false
    end

    local tree = tile:tree()
    return tree and tree:ready()
end

local function plantAll()
    local world = client:world()
    if not world then return end

    local checkPos = Vector2i.new(0, 0)

    for _, tile in pairs(world.tiles) do
        local point = tile:point()
        local px, py = point.x, point.y

        checkPos.x = px
        checkPos.y = py + 1

        local below = world:tile(checkPos)

        if tile.foreground == 0 and isSolid(below) then
            local plantPos = Vector2i.new(px, py)

            if pathTo(plantPos) then
                client:place(
                    plantPos,
                    Config.PLANT_ID,
                    InventoryItemType.seed
                )

                sleep(Config.DELAY_PLANT)
            end
        end
    end
end

local function harvestAll()
    local world = client:world()
    if not world then return end

    for y = world.size.y - 2, 1, -1 do
        for x = 1, world.size.x - 2 do
            local treePos = Vector2i.new(x, y)
            local tile = world:tile(treePos)

            if isHarvestable(tile) then
                local myPos = client:point()

                local dist =
                    math.abs(myPos.x - x) +
                    math.abs(myPos.y - y)

                if dist > 2 then
                    if not pathTo(treePos) then
                        goto continue
                    end
                end

                repeat
                    client:hit(treePos)
                    sleep(Config.HIT_DELAY)

                    tile = world:tile(treePos)
                until not tile or tile.foreground == 0

                collectNearby(treePos)
                dropSeedIfFull()

                sleep(Config.TREE_DELAY)
            end

            ::continue::
        end
    end
end

runThread(function()
    warp()

    while true do
        if Config.MODE == "plant" then
            plantAll()
            break
        elseif Config.MODE == "harvest" then
            harvestAll()
        end

        sleep(Config.LOOP_DELAY)
    end
end)
